# Laravel API — local backend (preferred for development)
# iOS Simulator / desktop: 127.0.0.1
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Android emulator (use this instead of 127.0.0.1):
# API_BASE_URL=http://10.0.2.2:8000/api/v1

# Production example (Render):
# API_BASE_URL=https://property-management-platform.onrender.com/api/v1

# AI runs on the Laravel server via Gemini — set GEMINI_API_KEY in backend/.env
# No API keys needed in the mobile app.
